---
// Formgong contact form. Plain HTML POST works without JavaScript; the script below
// upgrades it to fetch with an inline status message.
interface Props { lang?: string }
const { lang = "en" } = Astro.props;
const accessKey = import.meta.env.PUBLIC_FORMGONG_ACCESS_KEY ?? "fk_your_access_key"; // public by design
const redirect = import.meta.env.PUBLIC_FORMGONG_REDIRECT;
---
<form class="fg-contact" action="https://formgong.com/submit" method="POST">
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="_lang" value={lang} />
  {redirect && <input type="hidden" name="_redirect" value={redirect} />}
  <label>Name <input type="text" name="name" autocomplete="name" required /></label>
  <label>Email <input type="email" name="email" autocomplete="email" required /></label>
  <label>Message <textarea name="message" rows="5" required></textarea></label>
  <!-- Honeypot: hidden from people, filled by bots. Keep it empty. -->
  <div class="hp" aria-hidden="true"><input type="text" name="botcheck" tabindex="-1" autocomplete="off" /></div>
  <button type="submit">Send</button>
  <p class="status" role="status"></p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>("form.fg-contact")) {
    const status = form.querySelector<HTMLElement>(".status")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      status.textContent = "Sending…";
      try {
        const response = await fetch(form.action, { method: "POST", headers: { Accept: "application/json" }, body: new FormData(form) });
        const result = await response.json();
        status.textContent = result.success ? (result.message || "Thank you! Your message has been sent.") : (result.message || "Something went wrong. Please try again.");
        status.dataset.state = result.success ? "sent" : "error";
        if (result.success) form.reset();
      } catch {
        status.textContent = "Network error. Check your connection and try again.";
        status.dataset.state = "error";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .fg-contact { display: grid; gap: 14px; background: #fff; padding: 28px; border-radius: 14px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
  label { display: grid; gap: 6px; font-weight: 500; }
  input, textarea { font: inherit; padding: 10px 12px; border: 1px solid #ccd; border-radius: 8px; }
  button { font: inherit; font-weight: 600; padding: 12px; border: 0; border-radius: 8px; background: #4f46e5; color: #fff; cursor: pointer; }
  button[disabled] { opacity: .7; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .status[data-state="sent"] { color: #15803d; }
  .status[data-state="error"] { color: #b91c1c; }
</style>
